{
  "id": "dvalincode",
  "command": "node",
  "args": [
    "{harness_root}/dvalincode/dist/index.js",
    "run",
    "--mode",
    "code",
    "--permission-mode",
    "bypass",
    "--quiet",
    "{prompt}"
  ],
  "env": {
    "DVALINCODE_PROVIDER": "openai",
    "DVALINCODE_API_KEY": "{key}",
    "DVALINCODE_BASE_URL": "{base_url}",
    "DVALINCODE_MODEL": "{model}"
  },
  "sandbox_ro_binds": [
    "{harness_root}/dvalincode"
  ]
}
