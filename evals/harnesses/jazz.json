{
  "id": "jazz",
  "command": "bun",
  "args": [
    "{harness_root}/jazz/packages/runtime/src/main.ts",
    "run",
    "--agent",
    "jazz-agent",
    "--no-tui"
  ],
  "env": {
    "OPENAI_API_KEY": "{key}",
    "OPENAI_BASE_URL": "{base_url}"
  },
  "prompt_via": "stdin",
  "sandbox_ro_binds": [
    "{harness_root}/jazz",
    "{home}/.jazz"
  ]
}
