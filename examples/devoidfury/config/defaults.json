{
  "log_level": "warn",
  "log_target": "stderr",
  "default_model": "ai365/qwen3.8-27b",
  "thinker": " 🧠 ... {}",
  "tool_call_display_format": " 🔧 {} {}",
  "hide_tools": true,
  "show_token_use": true,
  "extension_paths": ["@extensions"],
  "extension_autoload": true,
  "default_subcommand": "cli",
  "chat_timeout_secs": 900,
  "workspace": {
    "paths": [".", "/skills", "/tmp", "/etc/hotdog"]
  },
  "profiles": {
    "default": {
      "blacklist-tools": ["explore"]
    },
    "explorer": {
      "model": "ai365/lfm2.5-8b-a1b"
    },
    "generate": {
      "model": "ai365/qwen3.6-35b:general"
    },
    "fixer": {
      "model": "ai365/qwen3.8-27b:instruct"
    },
    "test": {
      "model": "ai365/qwen3.5-4b:coder"
    }
  },
  "ui-interactive-cli": {
    "shell-mode": true
  },
  "skills": {
    "path": "/skills"
  },
  "agents-md": {
    "autoload": false
  },
  "websocket": {
    "port": 3001,
    "host": "0.0.0.0",
    "session-timeout-min": 30,
    "question-timeout-secs": 300,
    "question-strategy": "wait"
  },
  "webui": {
    "port": 3001,
    "host": "0.0.0.0",
    "session-token-ttl-min": 1440
  },
  "mcp-servers": [
    {
      "enabled": false,
      "name": "bun-docs-mcp",
      "url": "https://bun.com/docs/mcp"
    }
  ],
  "providers": [
    {
      "name": "ai365",
      "fetchModels": true,
      "models": []
    },

    {
      "name": "home",
      "url": "http://mini.home:9292",
      "models": [
        {
          "name": "qwen3.6-27b",
          "context-limit": 120000
        },
        {
          "name": "ornith-9b",
          "context-limit": 262144
        },
        {
          "name": "ornith-35b",
          "context-limit": 262144
        },
        {
          "name": "gemma-4-12b",
          "context-limit": 262144
        }
      ]
    }
  ]
}
