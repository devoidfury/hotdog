{
  "log_level": "warn",
  "log_target": "stderr",
  "default_model": "ai365/qwen3.8-flash-next",
  "thinker": " 🧠 ... {}",
  "tool_call_display_format": " 🔧 {} {}",
  "show-token-use": true,
  "extension-paths": ["@extensions", "@experimental"],
  "default-subcommand": "cli",
  "chat-timeout-secs": 1200,
  "workspace": {
    "paths": [".", "/skills", "/data", "/tmp", "/etc/hotdog"]
  },
  "model-groups": {
    "coders": ["qwen3.8-flash-next"]
  },
  "profiles": {
    "explorer": {
    },
    "test": {
      "model": "lfm2.5-8b-a1b"
    }
  },
  "ui-interactive-cli": {
    "shell-mode": true,
    "paste-marker-min-chars": 800
  },
  "skills": {
    "path": "/skills"
  },
  "agents-md": {
    "autoload": false
  },
  "websocket": {
    "session-timeout-min": 30,
    "question-timeout-secs": 300,
    "question-strategy": "wait"
  },
  "webui": {
    "port": 3001,
    "host": "0.0.0.0",
    "session-token-ttl-min": 1440
  },
  "mcp-servers": [
    {
      "enabled": true,
      "name": "bun-docs-mcp",
      "url": "https://bun.com/docs/mcp"
    }
  ],
  "workflows": {
    "max-runtime-mins": 90,
    "max-nodes": 24
  },
  "providers": [
    {
      "name": "ai365",
      "fetch-models": true
    },
    {
      "name": "mf-ai",
      "fetch-models": true,
      "apiKey": "$HOTDOG_ALT_KEY",
      "url": "$HOTDOG_ALT_URL"
    },
    {
      "name": "home",
      "fetch-models": true,
      "apiKey": "$HOTDOG_ALT_KEY",
      "url": "http://mini.home:9292"
    }
  ]
}
