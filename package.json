{
  "name": "@read-receipt/hotdog",
  "version": "0.12.1",
  "main": "bin/hotdog",
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "bin": {
    "hotdog": "bin/hotdog"
  },
  "description": "AI agent harness with tool calling support. Zero dependencies, just bun.",
  "engines": {
    "bun": ">=1.4.2"
  },
  "author": "Thomas Hunkapiller <tom@furycodes.com> (https://furycodes.com/)",
  "repository": "github:devoidfury/hotdog",
  "scripts": {
    "start": "bun bin/hotdog",
    "loud-test": "bun test --parallel",
    "test": "HOTDOG_LOG_LEVEL=error HOTDOG_LOG_TARGET=none bun test --only-failures --parallel",
    "coverage": "HOTDOG_LOG_LEVEL=error HOTDOG_LOG_TARGET=none bun test --only-failures --coverage",
    "check": "bun x tsc --noEmit",
    "preview": "bun tools/preview.ts",
    "gen-fixtures": "bun evals/tools/prepare.ts"
  },
  "files": ["bin", "src", "examples", "tsconfig.json"],
  "publishConfig": { "access": "public", "provenance": true },
  "type": "module",
  "license": "MIT"
}
