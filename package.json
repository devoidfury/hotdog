{
  "name": "@hotdog/agent",
  "version": "0.4.1",
  "main": "bin/hotdog",
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "bin": {
    "hotdog": "bin/hotdog"
  },
  "description": "AI agent harness with tool calling support. Zero dependencies, just bun.",
  "engines": {
    "bun": ">=1.0"
  },
  "author": "Thomas Hunkapiller <tom@furycodes.com> (http://furycodes.com/)",
  "repository": "github:devoidfury/hotdog",
  "scripts": {
    "start": "bun bin/hotdog",
    "test": "HOTDOG_LOG_LEVEL=error HOTDOG_LOG_TARGET=none bun test --only-failures --parallel --preload ./tests/setup.ts",
    "coverage": "HOTDOG_LOG_LEVEL=error HOTDOG_LOG_TARGET=none bun test --only-failures --preload ./tests/setup.ts --coverage",
    "check": "bun x tsc --noEmit"
  },
  "type": "module",
  "license": "MIT"
}
